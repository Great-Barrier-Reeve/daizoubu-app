<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_width="match_parent"
    tools:context=".ui.bounties.BountiesActivity"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- section for app bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sectionAppBar"
        android:layout_height="0dp"
        android:layout_width="match_parent"
        app:cardBackgroundColor="?android:attr/windowBackground"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="6.5:1"
        app:layout_constraintHeight_min="58dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_height="match_parent"
            android:layout_width="match_parent">

            <ImageView
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_circle"
                android:id="@+id/iconBack"
                android:layout_height="0dp"
                android:layout_width="0dp"
                android:src="@drawable/icon_arrow_left"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintHeight_percent="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- responsive buffer -->
            <View
                android:id="@+id/bufferTitleAppBar"
                android:layout_height="0dp"
                android:layout_width="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.25"
                app:layout_constraintStart_toEndOf="@id/iconBack"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:id="@+id/textViewTitleOrder"
                android:layout_height="0dp"
                android:layout_width="0dp"
                android:maxLines="1"
                android:text="@string/bounties"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                app:autoSizeMinTextSize="24sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.5"
                app:layout_constraintStart_toEndOf="@id/bufferTitleAppBar"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- body contents -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_height="0dp"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sectionAppBar">

        <!-- scrollable window -->
        <com.google.android.material.card.MaterialCardView
            android:layout_height="0dp"
            android:layout_width="match_parent"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="1.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <!-- scrollable body -->
            <androidx.core.widget.NestedScrollView
                android:layout_height="wrap_content"
                android:layout_width="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent">

                    <!-- top buffer -->
                    <View
                        android:id="@+id/bufferTop"
                        android:layout_height="0dp"
                        android:layout_width="match_parent"
                        app:layout_constraintDimensionRatio="H,24:1"
                        app:layout_constraintHeight_percent="0.15"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- section for my orders -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/sectionMyOrders"
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/bufferTop">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardHeaderMyOrders"
                            android:layout_height="0dp"
                            android:layout_width="0dp"
                            app:cardBackgroundColor="?attr/colorPrimary"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:layout_constraintDimensionRatio="H,6.5:1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.35"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/textViewHeaderMyOrders"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text=" My Orders "
                                android:textAllCaps="true"
                                android:textColor="?android:attr/windowBackground"
                                android:textStyle="bold"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeTextType="uniform" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/textViewEmptyMyOrders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="No orders yet."
                            android:textColor="?attr/colorSecondary"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cardHeaderMyOrders" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewMyOrders"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:nestedScrollingEnabled="false"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cardHeaderMyOrders" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- buffer between sections -->
                    <View
                        android:id="@+id/bufferAfterMyOrders"
                        android:layout_height="0dp"
                        android:layout_width="match_parent"
                        app:layout_constraintDimensionRatio="H,24:1"
                        app:layout_constraintHeight_percent="0.15"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/sectionMyOrders" />

                    <!-- section for my deliveries -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/sectionMyDeliveries"
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/bufferAfterMyOrders">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardHeaderMyDeliveries"
                            android:layout_height="0dp"
                            android:layout_width="0dp"
                            app:cardBackgroundColor="?attr/colorPrimary"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:layout_constraintDimensionRatio="H,6.5:1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.5"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/textViewHeaderMyDeliveries"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text=" My Deliveries "
                                android:textAllCaps="true"
                                android:textColor="?android:attr/windowBackground"
                                android:textStyle="bold"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeTextType="uniform" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/textViewEmptyMyDeliveries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="No deliveries yet."
                            android:textColor="?attr/colorSecondary"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cardHeaderMyDeliveries" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewMyDeliveries"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:nestedScrollingEnabled="false"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cardHeaderMyDeliveries" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- buffer between sections -->
                    <View
                        android:id="@+id/bufferAfterMyDeliveries"
                        android:layout_height="0dp"
                        android:layout_width="match_parent"
                        app:layout_constraintDimensionRatio="H,24:1"
                        app:layout_constraintHeight_percent="0.15"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/sectionMyDeliveries" />

                    <!-- section for available bounties -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/sectionAvailableBounties"
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/bufferAfterMyDeliveries">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardHeaderAvailableBounties"
                            android:layout_height="0dp"
                            android:layout_width="0dp"
                            app:cardBackgroundColor="?attr/colorPrimary"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:layout_constraintDimensionRatio="H,6.5:1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.5"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/textViewHeaderAvailableBounties"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text=" Available Bounties "
                                android:textAllCaps="true"
                                android:textColor="?android:attr/windowBackground"
                                android:textStyle="bold"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeTextType="uniform" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/textViewEmptyAvailableBounties"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="No bounties available."
                            android:textColor="?attr/colorSecondary"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cardHeaderAvailableBounties" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewBounties"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent"
                            android:nestedScrollingEnabled="false"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/cardHeaderAvailableBounties" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- bottom buffer -->
                    <View
                        android:id="@+id/bufferBottom"
                        android:layout_height="0dp"
                        android:layout_width="match_parent"
                        app:layout_constraintDimensionRatio="H,24:1"
                        app:layout_constraintHeight_percent="0.15"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/sectionAvailableBounties" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.core.widget.NestedScrollView>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
