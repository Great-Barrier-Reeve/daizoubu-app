                    app:layout_constraintStart_toEndOf="@id/buttonNumpadEight"
                    app:layout_constraintTop_toBottomOf="@id/buttonNumpadEight"
                    app:layout_constraintWidth_percent="0.04" />

                <!-- section for numpad delete -->
                <com.google.android.material.card.MaterialCardView
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/buttonNumpadDelete"
                    android:layout_height="0dp"
                    android:layout_width="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:layout_constraintDimensionRatio="H,1.5:1"
                    app:layout_constraintStart_toEndOf="@id/bufferNumpadBottomRight"
                    app:layout_constraintTop_toBottomOf="@id/bufferNumpadBottomRight"
                    app:layout_constraintWidth_percent="0.2"
                    app:strokeColor="?attr/colorSecondary"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_height="match_parent"
                        android:layout_width="match_parent">

                        <ImageView
                            android:id="@+id/iconDelete"
                            android:layout_height="0dp"
                            android:layout_width="0dp"
                            android:src="@drawable/icon_delete"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHeight_percent="0.5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- responsive buffer -->
            <View
                android:id="@+id/bufferDialogButtonSubmit"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,24:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sectionNumpadDialog" />

            <com.google.android.material.card.MaterialCardView
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/buttonDialogSubmit"
                android:layout_height="0dp"
                android:layout_width="0dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintDimensionRatio="H,5.1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bufferDialogButtonSubmit"
                app:layout_constraintWidth_percent="0.68"
                app:strokeColor="?attr/colorSecondary"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_height="match_parent"
                    android:layout_width="match_parent">

                    <TextView
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:id="@+id/textViewDialogConfirm"
                        android:layout_height="0dp"
                        android:layout_width="match_parent"
                        android:text="@string/confirm"
                        android:textColor="?android:attr/windowBackground"
                        android:textStyle="bold"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeTextType="uniform"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="H,10.2:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- responsive buffer -->
            <View
                android:id="@+id/BufferDialogBottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,24:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/buttonDialogSubmit" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>