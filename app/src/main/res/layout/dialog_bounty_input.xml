<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_gravity="center"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- background rounded card -->
    <com.google.android.material.card.MaterialCardView
        android:alpha="0.9"
        android:layout_height="0dp"
        android:layout_width="match_parent"
        app:cardBackgroundColor="?android:attr/windowBackground"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1.21"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <!-- card contents -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_height="match_parent"
            android:layout_width="match_parent">

            <!-- responsive buffer -->
            <View
                android:id="@+id/bufferDialogSubtitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,24:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:gravity="center"
                android:includeFontPadding="false"
                android:id="@+id/textViewDialogSubtitle"
                android:layout_height="0dp"
                android:layout_width="match_parent"
                android:text="@string/amount_enter"
                android:textColor="?attr/colorSecondary"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintDimensionRatio="H,20:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bufferDialogSubtitle" />

            <!-- responsive buffer -->
            <View
                android:id="@+id/bufferDialogBountyAmount"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,48:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewDialogSubtitle" />

            <TextView
                android:gravity="center"
                android:includeFontPadding="false"
                android:id="@+id/textViewDialogBountyAmount"
                android:layout_height="0dp"
                android:layout_width="match_parent"
                android:text="$67.67"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintDimensionRatio="H,6.67:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bufferDialogBountyAmount" />

            <!-- responsive buffer -->
            <View
                android:id="@+id/bufferDivDialog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,24:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewDialogBountyAmount" />

            <!-- horizontal divider -->
            <View
                android:alpha="0.5"
                android:background="?attr/colorSecondary"
                android:id="@+id/divDialog"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bufferDivDialog" />

            <!-- responsive buffer -->
            <View
                android:id="@+id/bufferSectionNumpadDialog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,24:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divDialog" />

            <!-- section for numpad -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sectionNumpadDialog"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bufferSectionNumpadDialog">

                <!-- section for numpad one -->
